# Copy to .env and fill in. Never commit .env.

# development | production
APP_ENV=development
# Long random string — generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database. Blank = SQLite file in instance/seahorse.db.  PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/seahorse
DATABASE_URL=

# Public address of the site (used in emails and PayFast return/notify URLs). e.g. https://seahorseride.co.za
PUBLIC_SITE_URL=

# ---- Administrator ---------------------------------------------------------
# Created automatically the first time the site starts (if no administrator exists yet).
# Blank in development = admin@seahorse.local / Seahorse@2026 (change it after signing in).
ADMIN_EMAIL=celenothandosihle@gmail.com
ADMIN_PASSWORD=

# ---- Public link -----------------------------------------------------------
# true = when you run python app.py, the site also gets a free temporary https://….trycloudflare.com address that
# anyone can open (shown in the terminal with a QR code). It also lets PayFast confirm payments. false = this computer only.
PUBLIC_LINK=true

# ---- Payments -------------------------------------------------------------
# auto      = Paystack when PAYSTACK_SECRET_KEY is set, otherwise PayFast sandbox (default)
# paystack  = Paystack card checkout: the customer types card number, expiry date and CVV on Paystack's page
# payfast   = the PayFast payment page
# simulator = offline look-alike, only for coding without internet (refuses to run in production)
PAYMENT_PROVIDER=auto
# Paystack keys: https://dashboard.paystack.com → Settings → API Keys & Webhooks.
# sk_test_… / pk_test_… = TEST mode (test cards, no real money). Works on localhost too — payments are
# verified with Paystack's API when the customer comes back. Webhook URL (optional, for the live site):
#   https://<your site>/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=ZAR
# true  = PayFast SANDBOX: real PayFast page, test cards, no money moves (use this until the client is ready)
# false = LIVE: real cards, real money — needs the business's own PayFast merchant account below
PAYFAST_SANDBOX=true
# On your own computer PayFast can't reach "localhost" to confirm payments, so the site opens a free,
# Your own sandbox credentials from https://sandbox.payfast.co.za (blank = PayFast's public test merchant),
# or your live credentials from the PayFast dashboard when PAYFAST_SANDBOX=false.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Optional override. Default: PUBLIC_SITE_URL + /payments/payfast/notify
PAYFAST_NOTIFY_URL=
# Check that ITNs come from PayFast's servers (keep true in production)
PAYFAST_VERIFY_SOURCE=true

# ---- Email via Brevo's HTTPS API (use this on hosts that block SMTP, e.g. Render free) ----
BREVO_API_KEY=

# ---- Email (SMTP) -----------------------------------------------------------
# Gmail example (needs 2-Step Verification, then an App password from myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<the 16-letter app password>   MAIL_FROM="Seahorse Ride <you@gmail.com>"
# Blank SMTP_HOST = emails are recorded in Admin → Email outbox instead of being sent.
# Examples: Brevo smtp-relay.brevo.com:587, Gmail smtp.gmail.com:587 (app password), Outlook smtp.office365.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Seahorse Ride <bookings@example.com>"

MAX_UPLOAD_MB=5

# Load example bookings in every status the first time the site starts on an empty database (used on the live demo).
# DEMO_DATA=true
# DEMO_PASSWORD=Password123   # customer@ and guide@seahorse.test (created automatically); admin@seahorse.test uses ADMIN_PASSWORD
# RESET_ADMIN_PASSWORD=true   # set once to make the ADMIN_EMAIL account use the current ADMIN_PASSWORD again
